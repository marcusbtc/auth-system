APP_NAME=Auth System FastAPI
APP_VERSION=2.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development

MONGO_URI=mongodb://localhost:27017
MONGO_DB=auth_system
REDIS_URL=
REDIS_PREFIX=authsys

JWT_SECRET=replace-with-a-very-strong-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ACTIVATION_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=30

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["Authorization","Content-Type","X-CSRF-Token","X-Request-ID"]
TRUSTED_HOSTS=["localhost","127.0.0.1","*.localhost"]
SECURITY_HEADERS_ENABLED=true

LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
FORGOT_RATE_LIMIT_WINDOW_SECONDS=300
FORGOT_RATE_LIMIT_MAX_ATTEMPTS=3

ADMIN_SEED_ENABLED=true
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=password

DEBUG_EXPOSE_TOKENS=false
